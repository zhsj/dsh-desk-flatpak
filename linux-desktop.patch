From 542a0ec6b5f8e2677ebaa2c7f427a53310dee663 Mon Sep 17 00:00:00 2001
From: Shengjing Zhu <i@zhsj.me>
Date: Thu, 1 Oct 2026 01:48:20 +0800
Subject: [PATCH 3/8] fix(desktop): make the landlock sandbox work from the
 packaged app

The ASAR archive stays read-only and Electron rewrites ASAR paths only for
execFile/execFileSync, not for the spawnSync the landlock probe uses, so the
sandbox-local provider found no usable backend inside the Flatpak bundle:

- unpack **/bin/landlock-run from the archive so the launcher exists on
  the filesystem at all.
- rewrite the resolved app.asar path to app.asar.unpacked in the provider,
  the way the other unpacked native payloads (ripgrep, office-kit, cua-macos)
  are located. An environment override would let the ambient environment
  decide which binary confines a process, which the launcher package
  forbids, and a redirected variable would silently turn the probe into a
  fake "full" verdict.

Assisted-by: CodeBuddy:DeepSeek-V4.1-Flash
---
 apps/desktop/scripts/electron-builder-config.mjs | 1 +
 packages/sandbox/sandbox-local/src/index.ts      | 3 ++-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/scripts/electron-builder-config.mjs b/apps/desktop/scripts/electron-builder-config.mjs
index d5522e3da9..c64f078f57 100644
--- a/apps/desktop/scripts/electron-builder-config.mjs
+++ b/apps/desktop/scripts/electron-builder-config.mjs
@@ -77,6 +77,7 @@ export function createElectronBuilderConfig(
   let windowsCode = []
   const unpack = ['**/*.{node,dylib,dll,so,exe}', '**/*.so.*', '**/spawn-helper', '**/@vscode/ripgrep-*/bin/rg',
     `**/node_modules/@deepseek-ai/libreoffice-kit-${resolvedPlatform}-${resolvedArch}/**/*`,
+    '**/bin/landlock-run',
     // LaunchServices opens the Computer Use helper as an application, so every file of its bundles stays on disk.
     // Both architectures ship: they form one notarized payload whose manifest staging verifies as a whole.
     '**/node_modules/@deepseek-ai/dsh-experimental-cua-macos/native/bin/**/*']
diff --git a/packages/sandbox/sandbox-local/src/index.ts b/packages/sandbox/sandbox-local/src/index.ts
index af8dae004f..911290185f 100644
--- a/packages/sandbox/sandbox-local/src/index.ts
+++ b/packages/sandbox/sandbox-local/src/index.ts
@@ -595,7 +595,8 @@ export class LocalSandboxProvider extends SandboxProvider {
 
   /** The Landlock launcher to probe and exec (test hook over the resolved one). */
   private landlockLauncher(): string {
-    return this.internals.landlockLauncher ?? landlockLauncherPath()
+    if (this.internals.landlockLauncher !== undefined) return this.internals.landlockLauncher
+    return landlockLauncherPath().replace('/app.asar/', '/app.asar.unpacked/')
   }
 
   /** The `sandbox-exec` executable to probe and exec (test hook over the system one). */
