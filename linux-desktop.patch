From 7fe634de668756885d857ef31f12926ea5e54e29 Mon Sep 17 00:00:00 2001
From: Shengjing Zhu <i@zhsj.me>
Date: Thu, 1 Oct 2026 01:48:20 +0800
Subject: [PATCH 2/4] fix(desktop): make the landlock sandbox work from the
 packaged app

The ASAR archive stays read-only and Electron resolves ASAR paths only for
execFile, not for the spawnSync the landlock probe uses, so the
sandbox-local provider found no usable backend inside the Flatpak bundle:

- unpack **/bin/landlock-run from the archive so the launcher exists on
  the filesystem at all.
- honor DSH_LANDLOCK_LAUNCHER ahead of the ASAR-path resolution, so a
  deployment that copies the launcher outside the archive can point the
  provider at it.

Assisted-by: Claude-Code:DeepSeek-V4-Pro
---
 apps/desktop/scripts/electron-builder-config.mjs | 2 +-
 packages/sandbox/sandbox-local/src/index.ts      | 8 +++++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/scripts/electron-builder-config.mjs b/apps/desktop/scripts/electron-builder-config.mjs
index 1fb787803c..b9b58e3fd8 100644
--- a/apps/desktop/scripts/electron-builder-config.mjs
+++ b/apps/desktop/scripts/electron-builder-config.mjs
@@ -69,7 +69,7 @@ export function createElectronBuilderConfig(
   let primaryRuntimeDestination
   let dshDestination
   let windowsCode = []
-  const unpack = ['**/*.{node,dylib,dll,so,exe}', '**/*.so.*', '**/spawn-helper', '**/@vscode/ripgrep-*/bin/rg',
+  const unpack = ['**/*.{node,dylib,dll,so,exe}', '**/*.so.*', '**/spawn-helper', '**/bin/landlock-run', '**/@vscode/ripgrep-*/bin/rg',
     `**/node_modules/@deepseek-ai/libreoffice-kit-${resolvedPlatform}-${resolvedArch}/**/*`]
   const windowsSigner = packagesWindows && !unsigned
     ? createWindowsTokenSigner({
diff --git a/packages/sandbox/sandbox-local/src/index.ts b/packages/sandbox/sandbox-local/src/index.ts
index 45028746ff..dd71524623 100644
--- a/packages/sandbox/sandbox-local/src/index.ts
+++ b/packages/sandbox/sandbox-local/src/index.ts
@@ -552,7 +552,13 @@ export class LocalSandboxProvider extends SandboxProvider {
 
   /** The Landlock launcher to probe and exec (test hook over the resolved one). */
   private landlockLauncher(): string {
-    return this.internals.landlockLauncher ?? landlockLauncherPath()
+    if (this.internals.landlockLauncher !== undefined) return this.internals.landlockLauncher
+    // Electron's spawn/execFile handles ASAR paths only for execFile, not
+    // for spawnSync (used by the probe below).  Flatpak deployments ship
+    // a copy of the launcher outside the read-only ASAR archive so that
+    // the probe and confine() can spawn it on a real filesystem path.
+    if (process.env.DSH_LANDLOCK_LAUNCHER !== undefined) return process.env.DSH_LANDLOCK_LAUNCHER
+    return landlockLauncherPath()
   }
 
   /** The `sandbox-exec` executable to probe and exec (test hook over the system one). */
