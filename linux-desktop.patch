index acf4b4e738..330fd0233a 100644
--- a/packages/sandbox/sandbox-local/src/index.ts
+++ b/packages/sandbox/sandbox-local/src/index.ts
@@ -555,7 +555,13 @@ export class LocalSandboxProvider extends SandboxProvider {
 
