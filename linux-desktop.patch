+        field = start + aligned(field - start, 8)
+        const code = inbox.readUInt8(field)
+        const length = inbox.readUInt8(field + 1)
+        field += 2
+        const signature = inbox.toString('utf8', field, field + length)
+        field += length + 1
+        if (signature === 'u') {
+          field = start + aligned(field - start, 4)
+          const value = inbox.readUInt32LE(field)
+          field += 4
+          if (code === 5) message.replySerial = value
+        } else if (signature === 's' || signature === 'o') {
+          field = start + aligned(field - start, 4)
+          const size = inbox.readUInt32LE(field)
+          const value = inbox.toString('utf8', field + 4, field + 4 + size)
+          field += 4 + size + 1
+          if (code === 1) message.path = value
+          if (code === 3) message.member = value
+        } else if (signature === 'g') {
+          field += inbox.readUInt8(field) + 2
+        } else {
+          throw new Error(`unsupported header field ${signature}`)
+        }
+      }
+      message.body = inbox.subarray(body, end)
+    } catch (error) {
+      console.error('desktop update: unreadable flatpak portal message', error)
+    }
+    messages.push(message)
+    cursor = end
+  }
+  return { messages, consumed: cursor }
+}
+
+function sessionAddress(): string | undefined {
+  const runtime = process.env.XDG_RUNTIME_DIR
+  const raw = process.env.DBUS_SESSION_BUS_ADDRESS
+  if (raw === undefined) return runtime === undefined ? undefined : `${runtime}/bus`
+  for (const entry of raw.split(';')) {
+    const [prefix = '', ...pairs] = entry.split(',')
+    const [transport, ...first] = prefix.split(':')
+    if (transport !== 'unix') continue
+    const options = [first.join(':'), ...pairs]
+    for (const option of options) {
+      const [name, ...rest] = option.split('=')
+      const value = rest.join('=')
+      if (name === 'path') return value
+      if (name === 'abstract') return `\0${value}`
+      if (name === 'runtime' && runtime !== undefined) return `${runtime}/bus`
+    }
+  }
+  return undefined
+}
+
+export class FlatpakUpdateMonitor {
+  private socket: Socket | undefined
+  private serial = 1
+  private helloSerial = 0
+  private createSerial = 0
+  private monitorPath: string | undefined
+  private announced = false
+  private closed = false
+  private authenticating = true
+  private auth = ''
+  private inbox = Buffer.alloc(0)
+  private timer: ReturnType<typeof setTimeout> | undefined
+
+  constructor(private readonly onUpdate: () => void = () => {}) {}
+
+  get available(): boolean { return this.announced }
+
+  start(): void {
+    const path = sessionAddress()
+    if (path === undefined) {
+      console.error('desktop update: no session bus address')
+      return
+    }
+    const socket = createConnection({ path })
+    this.socket = socket
+    socket.on('error', (error: unknown) => { console.error('desktop update: flatpak portal unavailable', error) })
+    socket.on('close', () => { this.stop() })
+    socket.on('connect', () => { socket.write(Buffer.from([0])); socket.write(this.authLine()) })
+    socket.on('data', (chunk: Buffer) => { this.receive(chunk) })
+    this.timer = setTimeout(() => {
+      if (this.monitorPath !== undefined) return
+      console.error('desktop update: flatpak portal did not answer')
+      this.close()
+    }, REPLY_TIMEOUT_MS)
+  }
+
+  close(): void {
+    if (this.closed) return
+    if (this.monitorPath !== undefined) this.call(this.monitorPath, UPDATE_INTERFACE, 'Close')
+    this.stop()
+  }
+
+  private authLine(): string {
+    const uid = Buffer.from(String(process.getuid?.() ?? 0), 'utf8').toString('hex')
+    return `AUTH EXTERNAL ${uid}\r\n`
+  }
+
+  private stop(): void {
+    this.closed = true
+    if (this.timer !== undefined) clearTimeout(this.timer)
+    this.timer = undefined
+    this.socket?.end()
+    this.socket = undefined
+  }
+
+  private receive(chunk: Buffer): void {
+    if (this.authenticating) {
+      this.auth += chunk.toString('latin1')
+      const end = this.auth.indexOf('\r\n')
+      if (end < 0) return
+      const line = this.auth.slice(0, end)
+      const rest = this.auth.slice(end + 2)
+      this.auth = ''
+      if (line.startsWith('REJECTED')) {
+        console.error('desktop update: session bus rejected authentication')
+        this.close()
+        return
+      }
+      if (!line.startsWith('OK ')) {
+        this.auth = rest
+        return
+      }
+      this.authenticating = false
+      this.socket?.write('BEGIN\r\n')
+      this.helloSerial = this.call(BUS_PATH, BUS, 'Hello', BUS)
+      if (rest.length === 0) return
+      chunk = Buffer.from(rest, 'latin1')
+    }
+    this.inbox = Buffer.concat([this.inbox, chunk])
+    const { messages, consumed } = decode(this.inbox)
+    this.inbox = this.inbox.subarray(consumed)
+    for (const message of messages) this.handle(message)
+  }
+
+  private handle(message: Incoming): void {
+    if (message.type === ERROR) {
+      if (message.replySerial !== this.createSerial) return
+      console.error('desktop update: flatpak portal rejected the update monitor')
+      this.close()
+      return
+    }
+    if (message.type === METHOD_RETURN) {
+      if (message.replySerial === this.helloSerial) this.create()
+      else if (message.replySerial === this.createSerial) this.watch(message.body)
+      return
+    }
+    if (message.type !== SIGNAL || message.member !== 'UpdateAvailable') return
+    if (message.path !== this.monitorPath || this.announced) return
+    this.announced = true
+    this.onUpdate()
+  }
+
+  private create(): void {
+    this.createSerial = this.call(PORTAL_PATH, PORTAL, 'CreateUpdateMonitor', PORTAL, 'a{sv}', Buffer.alloc(8))
+  }
+
+  private watch(body: Buffer): void {
+    const size = body.readUInt32LE(0)
+    this.monitorPath = body.toString('utf8', 4, 4 + size)
+    console.log('desktop update: watching flatpak updates', this.monitorPath)
+    if (this.timer !== undefined) clearTimeout(this.timer)
+    this.timer = undefined
+    const rule = `type='signal',interface='${UPDATE_INTERFACE}',member='UpdateAvailable',path='${this.monitorPath}'`
+    this.call(BUS_PATH, BUS, 'AddMatch', BUS, 's', stringBody(rule))
+  }
+
+  private call(path: string, iface: string, member: string, destination?: string, signature?: string, body?: Buffer): number {
+    const serial = this.serial++
+    const fields: Field[] = [{ code: 1, type: 'o', value: path }, { code: 2, type: 's', value: iface },
+      { code: 3, type: 's', value: member }]
+    if (destination !== undefined) fields.push({ code: 6, type: 's', value: destination })
+    if (signature !== undefined) fields.push({ code: 8, type: 'g', value: signature })
+    this.socket?.write(encode(METHOD_CALL, serial, fields, body ?? Buffer.alloc(0)))
+    return serial
+  }
+}
